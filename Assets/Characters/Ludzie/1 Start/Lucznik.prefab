  m_Name: 
  m_EditorClassIdentifier: 
  Id: 5
  Name:
  - Srebrny Strzelec
  - Silver Marksman
  - Arquero Plateado
  - "Archer Argent\xE9"
  - "Silberner Sch\xFCtze"
  Cost: 3
  Star: 1
  SoundEffect:
    audioSource: {fileID: 0}
    walk:
    - {fileID: 0}
    hit:
    - {fileID: 0}
    specialEffect:
    - {fileID: 0}
    update:
    - {fileID: 0}
    evolve:
    - {fileID: 0}
    umieranie: []
    hitSword: []
    hitPunch: []
    hitKosa: []
    hitBite: []
    hitMlot: []
    hitMeleMagia: []
    hitRangeMagia: []
